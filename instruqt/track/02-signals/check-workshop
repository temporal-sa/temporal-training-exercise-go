#!/bin/bash
# ABOUTME: Check script. Fill-in-the-blanks style.
# Gate 1: TODOs gone from the four files the attendee edits.
# Gate 2: the package compiles and the Workflow listens on a Signal channel.
# Gate 3: a money transfer completed since this chapter started, and its
#         history records the approval Signal.
fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

export HOME="${HOME:-/root}" GOTOOLCHAIN=local
export PATH="/usr/local/go/bin:/usr/local/bin:$PATH"
cd /root/workshop || fail "Workshop directory is missing."

EX=exercise2
SINCE=$(cat /tmp/workshop-start-02 2>/dev/null || echo "1970-01-01T00:00:00Z")
T=(--address 127.0.0.1:7233 --namespace default)

for f in activities.go workflow.go worker/main.go starter/main.go; do
    if grep -q "TODO" "$EX/$f" 2>/dev/null; then
        fail "$EX/$f still has TODO comments. Implement them, delete the comments, then check again."
    fi
done
pass "All TODOs implemented"

if ! OUT=$(go build ./$EX/... 2>&1); then
    echo "$OUT" | tail -15
    fail "$EX does not compile. Fix the errors above, then check again."
fi
pass "$EX compiles"

if ! grep -q 'GetSignalChannel' "$EX/workflow.go" 2>/dev/null; then
    fail "$EX/workflow.go never calls workflow.GetSignalChannel. The approve Signal needs a channel."
fi
pass "Signal channel present"

COMPLETED=$(temporal workflow count "${T[@]}" -o json \
    --query "WorkflowId=\"money-transfer-workflow\" AND ExecutionStatus=\"Completed\" AND StartTime > \"$SINCE\"" \
    2>/dev/null | jq -r '.count // 0' 2>/dev/null)
if [ "${COMPLETED:-0}" -lt 1 ]; then
    fail "No completed money transfer yet. Start the Worker, run the starter, and wait for the result to print."
fi
pass "Money transfer Workflow completed"

SIGNALS=$(temporal workflow show "${T[@]}" --workflow-id money-transfer-workflow -o json 2>/dev/null \
    | jq '[.events[] | select(.eventType == "EVENT_TYPE_WORKFLOW_EXECUTION_SIGNALED")] | length' 2>/dev/null)
if [ "${SIGNALS:-0}" -lt 1 ]; then
    fail "The latest transfer has no WorkflowExecutionSignaled event. Send the approve Signal from the starter or the CLI."
fi
pass "Approval Signal recorded in the event history"
