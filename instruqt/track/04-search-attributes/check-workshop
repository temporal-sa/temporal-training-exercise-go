#!/bin/bash
# ABOUTME: Check script. Fill-in-the-blanks style.
# Gate 1: the TODOs are gone and UpsertSearchAttributes is called.
# Gate 2: an execution started in this chapter actually carries
#         AccountId="account-123", which only happens if the upsert succeeded.
fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

export HOME="${HOME:-/root}" GOTOOLCHAIN=local
export PATH="/usr/local/go/bin:/usr/local/bin:$PATH"
cd /root/workshop || fail "Workshop directory is missing."

EX=exercise4
SINCE=$(cat /tmp/workshop-start-04 2>/dev/null || echo "1970-01-01T00:00:00Z")
T=(--address 127.0.0.1:7233 --namespace default)

if grep -q "TODO" "$EX/workflow.go" 2>/dev/null; then
    fail "$EX/workflow.go still has TODO comments. Implement them, delete the comments, then check again."
fi
pass "All TODOs implemented"

if ! OUT=$(go build ./$EX/... 2>&1); then
    echo "$OUT" | tail -15
    fail "$EX does not compile. Fix the errors above, then check again."
fi
pass "$EX compiles"

if ! grep -q 'UpsertSearchAttributes\|UpsertTypedSearchAttributes' "$EX/workflow.go" 2>/dev/null; then
    fail "$EX/workflow.go never calls workflow.UpsertSearchAttributes."
fi
pass "UpsertSearchAttributes called"

TAGGED=$(temporal workflow count "${T[@]}" -o json \
    --query "AccountId=\"account-123\" AND StartTime > \"$SINCE\"" \
    2>/dev/null | jq -r '.count // 0' 2>/dev/null)
if [ "${TAGGED:-0}" -lt 1 ]; then
    fail "No Workflow from this exercise carries AccountId=\"account-123\" yet. Run the Worker and the starter, then check again."
fi
pass "Workflow found by the AccountId search attribute"
